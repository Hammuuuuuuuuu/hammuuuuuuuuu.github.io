<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Edit Event</title>
</head>
<body>
    <h1>Edit Event</h1>
    <p>Created on: <%= event.created_at %></p>
    <form action="/organiser/edit/<%= event.event_id %>" method="POST">
        <div>
            <label for="title">Title:</label>
            <input type="text" id="title" name="title" value="<%= event.title %>" required>
        </div>
        <div>
            <label for="description">Description:</label>
            <textarea id="description" name="description"><%= event.description %></textarea>
        </div>
        <div>
            <label for="event_date">Event Date:</label>
            <input type="datetime-local" id="event_date" name="event_date" value="<%= event.event_date ? event.event_date.replace(' ', 'T') : '' %>">
        </div>
        <hr>
        <h3>Tickets</h3>
        <div>
            <label for="full_price_tickets_total">Full Price Tickets Quantity:</label>
            <input type="number" id="full_price_tickets_total" name="full_price_tickets_total" value="<%= event.full_price_tickets_total %>" min="0">
        </div>
        <div>
            <label for="full_price_tickets_price">Full Price Tickets Price:</label>
            <input type="number" id="full_price_tickets_price" name="full_price_tickets_price" value="<%= event.full_price_tickets_price %>" min="0" step="0.01">
        </div>
        <br>
        <div>
            <label for="concession_tickets_total">Concession Tickets Quantity:</label>
            <input type="number" id="concession_tickets_total" name="concession_tickets_total" value="<%= event.concession_tickets_total %>" min="0">
        </div>
        <div>
            <label for="concession_tickets_price">Concession Tickets Price:</label>
            <input type="number" id="concession_tickets_price" name="concession_tickets_price" value="<%= event.concession_tickets_price %>" min="0" step="0.01">
        </div>
        <br>
        <button type="submit">Update Event</button>
    </form>
    <br>
    <a href="/organiser">Back to Organiser Home</a>
</body>
</html>
